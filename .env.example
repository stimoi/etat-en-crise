# Copie ce fichier sous le nom ".env" puis remplis les valeurs.
# Le fichier .env reste sur ton ordinateur : ne le partage jamais (il est dans .gitignore).

# Port du serveur local (le jeu sera sur http://localhost:3000)
PORT=3000

# ---------------------------------------------------------------------
# IA CRAFTPICK — utilisée par « npm run craftpick » et « npm start »
# ---------------------------------------------------------------------
# Adresse de l'API (sans "/api/chat" à la fin, le code l'ajoute)
CRAFTPICK_API_URL=http://82.26.80.20:11434

# Nom exact du modèle, tel qu'il apparaît sur le serveur Ollama
CRAFTPICK_MODELE=gemma4:31b-cloud

# Facultatif : clé API, seulement si le serveur en exige une (laisser vide sinon)
CRAFTPICK_API_KEY=

# ---------------------------------------------------------------------
# IA LOCALE — utilisée par « npm run local » (Ollama installé sur ce PC)
# ---------------------------------------------------------------------
# Adresse d'Ollama sur ce PC (c'est la valeur par défaut, à ne changer que si besoin)
OLLAMA_LOCAL_URL=http://localhost:11434

# Modèle à utiliser en local (« npm run local -- autre-modele » pour en essayer un autre)
OLLAMA_LOCAL_MODELE=gemma4:31b-cloud

# ---------------------------------------------------------------------
# DISCORD — page « Le mur des mandats » (voir le README, section Discord)
# Laisse vide tant que ce n'est pas configuré : le jeu marche sans.
# ---------------------------------------------------------------------
# Application Discord (https://discord.com/developers/applications) > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Adresse de retour après connexion : à ajouter TELLE QUELLE dans OAuth2 > Redirects
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Application Discord > Bot > Reset Token (secret : ne le montre jamais)
DISCORD_BOT_TOKEN=
# Identifiants des salons (clic droit sur le salon > Copier l'identifiant)
DISCORD_SALON_RESULTATS=
DISCORD_SALON_VOTES=

# Ajout automatique : un joueur qui se connecte rejoint ton serveur Discord.
# Identifiant du serveur : clic droit sur l'icône du serveur > Copier l'identifiant du serveur.
# (Discord demande au joueur son accord sur la page de connexion.) Laisse vide pour désactiver.
DISCORD_SERVEUR_ID=
# Mettre 0 pour désactiver l'ajout automatique sans effacer l'identifiant.
DISCORD_AJOUT_AUTO=1

# Secret qui signe les sessions des joueurs : une longue suite de caractères au hasard.
# (Généré automatiquement dans ton .env ; « npm run discord » peut en créer un.)
SESSION_SECRET=

# ---------------------------------------------------------------------
# VERSION GITHUB PAGES (site en ligne sans ton PC) — voir le README, partie 12
# Remplis automatiquement par « npm run en-ligne » (mettre-en-ligne.bat).
# ---------------------------------------------------------------------
# Adresse du site, ex. https://pseudo.github.io/etat-en-crise/
PAGES_URL=
# Adresse du relais Cloudflare, ex. https://etat-en-crise-relais.pseudo.workers.dev
RELAIS_URL=
